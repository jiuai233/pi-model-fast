{
  "name": "pi-model-fast",
  "version": "0.1.2",
  "description": "Fast mode for Pi: per-model OpenAI/Codex priority controls and an auto-refreshing model catalog",
  "type": "module",
  "license": "MIT",
  "author": "jiuai233",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jiuai233/pi-model-fast.git"
  },
  "homepage": "https://github.com/jiuai233/pi-model-fast#readme",
  "bugs": {
    "url": "https://github.com/jiuai233/pi-model-fast/issues"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "fast",
    "fast-mode",
    "priority",
    "service-tier",
    "pi-coding-agent",
    "openai",
    "codex"
  ],
  "files": [
    "src/",
    "catalog/",
    "README.md",
    "README.zh-CN.md",
    "docs/assets/fast-status.png",
    "LICENSE"
  ],
  "pi": {
    "image": "https://raw.githubusercontent.com/jiuai233/pi-model-fast/main/docs/assets/fast-status.png",
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "update:catalog": "node scripts/update-catalog.ts",
    "check": "npm run typecheck && npm test"
  },
  "engines": {
    "node": ">=24"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.0.0",
    "@types/node": "^24.19.1",
    "typescript": "^7.0.2"
  }
}
